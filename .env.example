# Global Root Environment Configuration for Docker Compose

# Environment Name: local, staging, production
APP_ENV=local
APP_DEBUG=true

# Database (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vahancheck_db
DB_USERNAME=vahan_user
DB_PASSWORD=vahan_secure_pass_2026

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# MinIO / S3 Private Storage
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=minio_secret_pass_2026
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=vahan-storage
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Mock API Gateway
MOCK_API_PORT=4000
MOCK_API_URL=http://mock-api:4000

# Backend & Web Ports
BACKEND_PORT=8000
WEB_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025

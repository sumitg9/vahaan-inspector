# ==============================================================================
# VahanCheck Enterprise — Production Environment Secrets Configuration
# Non-Negotiable Invariants:
# 1. Zero Secret Leakage: No actual secrets, credentials, or production tokens
#    may be committed to version control.
# 2. Production Fail-Safe: APISATHI_PROD_ENABLED must remain false until
#    authorized credentials are provisioned. Mock fallback in production is forbidden.
# ==============================================================================

# Application Runtime Configuration
APP_NAME="VahanCheck Enterprise"
APP_ENV=production
APP_KEY="" # Generate via: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://vahancheck.enterprise
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

# Production Database (PostgreSQL 16 High-Availability Cluster)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vahancheck_prod
DB_USERNAME=vahan_prod_user
DB_PASSWORD="" # Strong auto-generated 32+ char password
DB_SSLMODE=prefer

# Redis 7 In-Memory Cache, Session & Queue Pipeline
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD="" # Strong auto-generated 32+ char password
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

# Private Object Storage (AWS S3 / MinIO Private Storage)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID="" # Dedicated IAM user with scoped S3 PUT/GET policy
AWS_SECRET_ACCESS_KEY="" # IAM user secret
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=vahancheck-prod-evidence
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT="" # Leave empty for official AWS S3; specify URL if using private MinIO

# Vehicle Intelligence API Providers (EXT-01)
# EXECUTE ONLY WHEN AUTHORIZED CREDENTIALS ARE PROVISIONED
PROVIDER_DEFAULT=apisathi
APISATHI_BASE_URL=https://apisathi.in/api/v1
APISATHI_API_KEY="" # Authorized live API key from client provider agreement
APISATHI_SECRET_KEY="" # Authorized live secret key from client provider agreement
APISATHI_TIMEOUT_SECONDS=8
APISATHI_PROD_ENABLED=false # Set to true ONLY when live credentials are verified

# Payment Gateway (Razorpay Production Credentials)
RAZORPAY_KEY_ID="" # Live production key rzp_live_...
RAZORPAY_KEY_SECRET="" # Live production secret
RAZORPAY_WEBHOOK_SECRET="" # HMAC SHA-256 webhook signing secret

# Production Email & SMS Notifications
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD="" # SendGrid or SES API key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@vahancheck.enterprise"
MAIL_FROM_NAME="VahanCheck Alerts"

# PDF Rendering Engine (Chromium)
PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium-browser"
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS="--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu"

# Database Backup Secret Key (Used for AES-256-CBC backup encryption)
BACKUP_ENCRYPTION_KEY="" # 64-char hex key for OpenSSL backup archive encryption

APP_NAME="VahanCheck API"
APP_ENV=local
APP_KEY=base64:sW3m9Oq8uR1e4G7t2Y5a8D0f3H6j1K4l7N9b2V5x8Z0=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (PostgreSQL 16 Primary)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vahancheck_db
DB_USERNAME=vahan_user
DB_PASSWORD=vahan_secure_pass_2026

# Session & Cache
SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX="vahan_cache_"

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email (Mailpit local)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@vahancheck.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 / MinIO Private Storage
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=minio_secret_pass_2026
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=vahan-storage
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://127.0.0.1:9000

# Vehicle Intelligence API Providers
PROVIDER_DEFAULT=mock
MOCK_API_BASE_URL=http://127.0.0.1:4000

# APISathi Credentials (To be populated once provisioned)
APISATHI_BASE_URL=https://apisathi.in/api/v1
APISATHI_API_KEY=""
APISATHI_SECRET_KEY=""
APISATHI_TIMEOUT_SECONDS=8

# PDF Generation Engine
PUPPETEER_EXECUTABLE_PATH=""
PUPPETEER_HEADLESS=true
